  "transcript": [
    {
      "id": "caption-1",
      "start": 0.8,
      "end": 2.324,
      "text": "In the kingdom of Eldmoor,",
      "source": "imported_caption"
    },
    {
      "id": "caption-2",
      "start": 2.364,
      "end": 4.41,
      "text": "a crown was about to change hands.",
      "source": "imported_caption"
    },
    {
      "id": "caption-3",
      "start": 6.5,
      "end": 8.14,
      "text": "On the eve of the coronation,",
      "source": "imported_caption"
    },
    {
      "id": "caption-4",
      "start": 8.18,
      "end": 9.646,
      "text": "King Aldric and Queen Mera",
      "source": "imported_caption"
    },
    {
      "id": "caption-5",
      "start": 9.686,
      "end": 11.268,
      "text": "feasted with their daughter,",
      "source": "imported_caption"
    },
    {
      "id": "caption-6",
      "start": 11.308,
      "end": 12.208,
      "text": "Princess Lyra.",
      "source": "imported_caption"
    },
    {
      "id": "caption-7",
      "start": 12.3,
      "end": 12.891,
      "text": "In the corner,",
      "source": "imported_caption"
    },
    {
      "id": "caption-8",
      "start": 12.931,
      "end": 14.018,
      "text": "the King's quiet brother,",
      "source": "imported_caption"
    },
    {
      "id": "caption-9",
      "start": 14.058,
      "end": 15.59,
      "text": "Alisson, polished the royal crown.",
      "source": "imported_caption"
    },
    {
      "id": "caption-10",
      "start": 16,
      "end": 17.009,
      "text": "And Chancellor Voss",
      "source": "imported_caption"
    },
    {
      "id": "caption-11",
      "start": 17.049,
      "end": 18.429,
      "text": "whispered in the shadows.",
      "source": "imported_caption"
    },
    {
      "id": "caption-12",
      "start": 18.6,
      "end": 20.575,
      "text": "By morning, the crown was gone.",
      "source": "imported_caption"
    },
    {
      "id": "caption-13",
      "start": 21.2,
      "end": 22.088,
      "text": "The King raged,",
      "source": "imported_caption"
    },
    {
      "id": "caption-14",
      "start": 22.128,
      "end": 24.5,
      "text": "Lyra wept, and Chancellor Voss declared",
      "source": "imported_caption"
    },
    {
      "id": "caption-15",
      "start": 24.54,
      "end": 26.458,
      "text": "that a thief walked among them.",
      "source": "imported_caption"
    },
    {
      "id": "caption-16",
      "start": 29.5,
      "end": 31.381,
      "text": "That evening, a hooded thief crept",
      "source": "imported_caption"
    },
    {
      "id": "caption-17",
      "start": 31.421,
      "end": 33.568,
      "text": "across the rooftops with a heavy sack.",
      "source": "imported_caption"
    },
    {
      "id": "caption-18",
      "start": 34,
      "end": 35.021,
      "text": "Someone in a green",
      "source": "imported_caption"
    },
    {
      "id": "caption-19",
      "start": 35.061,
      "end": 36.476,
      "text": "cloak was following him.",
      "source": "imported_caption"
    },
    {
      "id": "caption-20",
      "start": 37.4,
      "end": 38.926,
      "text": "When the thief looked away,",
      "source": "imported_caption"
    },
    {
      "id": "caption-21",
      "start": 38.966,
      "end": 40.01,
      "text": "the sack was gone.",
      "source": "imported_caption"
    },
    {
      "id": "caption-22",
      "start": 41.5,
      "end": 42.506,
      "text": "Later that night,",
      "source": "imported_caption"
    },
    {
      "id": "caption-23",
      "start": 42.546,
      "end": 43.839,
      "text": "Lyra could not sleep.",
      "source": "imported_caption"
    },
    {
      "id": "caption-24",
      "start": 44,
      "end": 45.036,
      "text": "From her balcony,",
      "source": "imported_caption"
    },
    {
      "id": "caption-25",
      "start": 45.076,
      "end": 47.251,
      "text": "she saw a lantern by the old vault,",
      "source": "imported_caption"
    },
    {
      "id": "caption-26",
      "start": 47.291,
      "end": 48.581,
      "text": "and Alisson, hiding a",
      "source": "imported_caption"
    },
    {
      "id": "caption-27",
      "start": 48.621,
      "end": 50.203,
      "text": "green bundle in the wall.",
      "source": "imported_caption"
    },
    {
      "id": "caption-28",
      "start": 53.5,
      "end": 54.502,
      "text": "At the council,",
      "source": "imported_caption"
    },
    {
      "id": "caption-29",
      "start": 54.542,
      "end": 55.96,
      "text": "Voss revealed a clue:",
      "source": "imported_caption"
    },
    {
      "id": "caption-30",
      "start": 56,
      "end": 57.001,
      "text": "a green thread,",
      "source": "imported_caption"
    },
    {
      "id": "caption-31",
      "start": 57.041,
      "end": 58.291,
      "text": "torn from a cloak.",
      "source": "imported_caption"
    },
    {
      "id": "caption-32",
      "start": 58.6,
      "end": 60.785,
      "text": "Find Alisson, the King commanded.",
      "source": "imported_caption"
    },
    {
      "id": "caption-33",
      "start": 60.9,
      "end": 62.678,
      "text": "But Alisson's chair stood empty.",
      "source": "imported_caption"
    },
    {
      "id": "caption-34",
      "start": 64.5,
      "end": 65.408,
      "text": "The next night,",
      "source": "imported_caption"
    },
    {
      "id": "caption-35",
      "start": 65.448,
      "end": 67.406,
      "text": "Lyra crept to the wall herself.",
      "source": "imported_caption"
    },
    {
      "id": "caption-36",
      "start": 67.6,
      "end": 69.564,
      "text": "Inside the bundle lay the crown,",
      "source": "imported_caption"
    },
    {
      "id": "caption-37",
      "start": 69.604,
      "end": 70.504,
      "text": "and a note.",
      "source": "imported_caption"
    },
    {
      "id": "caption-38",
      "start": 71,
      "end": 72.774,
      "text": "Trust me. Watch Voss.",
      "source": "imported_caption"
    },
    {
      "id": "caption-39",
      "start": 75.6,
      "end": 77.242,
      "text": "Alisson was not running away.",
      "source": "imported_caption"
    },
    {
      "id": "caption-40",
      "start": 77.9,
      "end": 80.385,
      "text": "At dawn, he met Captain Bren in secret,",
      "source": "imported_caption"
    },
    {
      "id": "caption-41",
      "start": 80.425,
      "end": 81.42,
      "text": "gave him a note,",
      "source": "imported_caption"
    },
    {
      "id": "caption-42",
      "start": 81.46,
      "end": 83.92,
      "text": "and pointed at the Chancellor's tower.",
      "source": "imported_caption"
    },
    {
      "id": "caption-43",
      "start": 86.5,
      "end": 88.988,
      "text": "In his tower, Voss raged at the thief:",
      "source": "imported_caption"
    },
    {
      "id": "caption-44",
      "start": 89.028,
      "end": 90.292,
      "text": "the crown was lost.",
      "source": "imported_caption"
    },
    {
      "id": "caption-45",
      "start": 91.2,
      "end": 92.591,
      "text": "But behind the curtain,",
      "source": "imported_caption"
    },
    {
      "id": "caption-46",
      "start": 92.631,
      "end": 94.497,
      "text": "Captain Bren heard every word.",
      "source": "imported_caption"
    },
    {
      "id": "caption-47",
      "start": 97.4,
      "end": 98.417,
      "text": "At the coronation,",
      "source": "imported_caption"
    },
    {
      "id": "caption-48",
      "start": 98.457,
      "end": 99.689,
      "text": "the doors swung open.",
      "source": "imported_caption"
    },
    {
      "id": "caption-49",
      "start": 99.8,
      "end": 101.728,
      "text": "Alisson carried in the true crown.",
      "source": "imported_caption"
    },
    {
      "id": "caption-50",
      "start": 101.9,
      "end": 103.233,
      "text": "The hired thief confessed,",
      "source": "imported_caption"
    },
    {
      "id": "caption-51",
      "start": 103.273,
      "end": 104.646,
      "text": "and Voss was dragged away.",
      "source": "imported_caption"
    },
    {
      "id": "caption-52",
      "start": 104.9,
      "end": 107.297,
      "text": "Alisson had protected the crown all along.",
      "source": "imported_caption"
    },
    {
      "id": "caption-53",
      "start": 107.6,
      "end": 108.547,
      "text": "Lyra was crowned,",
      "source": "imported_caption"
    },
    {
      "id": "caption-54",
      "start": 108.587,
      "end": 110.329,
      "text": "and the whole kingdom cheered.",
      "source": "imported_caption"
    },
    {
      "id": "caption-55",
      "start": 112.4,
      "end": 113.975,
      "text": "Queen Lyra ruled wisely.",
      "source": "imported_caption"
    },
    {
      "id": "caption-56",
      "start": 114.015,
      "end": 116.734,
      "text": "And quiet Alisson went back to polishing,",
      "source": "imported_caption"
    },
    {
      "id": "caption-57",
      "start": 116.774,
      "end": 117.784,
      "text": "just as before.",
      "source": "imported_caption"
    },
    {
      "id": "caption-58",
      "start": 118,
      "end": 119.079,
      "text": "The end.",
      "source": "imported_caption"
    }
  ],
