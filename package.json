{
  "name": "@amazon-devices/selene",
  "version": "0.0.1",
  "private": true,
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rm -rf node_modules buildinfo.json dist build",
    "start": "node --env-file=../.env server/index.mjs",
    "test": "node --test test/*.test.mjs",
    "test:snapshot": "jest --colors --updateSnapshot",
    "lint": "eslint src web test --ext .ts,.tsx",
    "lint:fix": "eslint src web test --ext .ts,.tsx --fix",
    "build:release": "react-native build-vega --build-type Release",
    "build:debug": "react-native build-vega --build-type Debug",
    "build:app": "npm-run-all build:release",
    "build": "npm run build:web && npm run build:release",
    "release": "npm-run-all typecheck lint test build",
    "dev": "npm run build:web && npm start",
    "build:web": "node scripts/build.mjs",
    "vega:vvd": "scripts/start-vega-vvd.sh",
    "vega:screenshot": "scripts/vega-screenshot.sh",
    "vega:run": "scripts/vega-run.sh",
    "vega:testvideo": "scripts/vega-testvideo.sh",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json",
    "test:live": "node --env-file=../.env scripts/live-check.mjs"
  },
  "dependencies": {
    "@amazon-devices/kepler-media-controls": "^1.0.25",
    "@amazon-devices/react-native-kepler": "^4.0.0",
    "@amazon-devices/webview": "^4.0.0",
    "@xmldom/xmldom": "^0.8.11",
    "ajv": "^8.17.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.0"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@amazon-devices/eslint-plugin-kepler": "^0.1.4",
    "@amazon-devices/kepler-cli-platform": "^0",
    "@react-native-community/cli": "20.0.0",
    "@react-native/babel-preset": "0.83.0",
    "@react-native/eslint-config": "0.83.0",
    "@react-native/metro-config": "0.83.0",
    "@testing-library/react-native": "^13.0.0",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "@typescript-eslint/eslint-plugin": "^6.5.0",
    "babel-jest": "^29.7.0",
    "esbuild": "^0.25.0",
    "eslint": "^8.57.1",
    "eslint-plugin-jest": "^27.6.0",
    "jest": "^29.7.0",
    "jsonc-eslint-parser": "^2.4.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^2.8.8",
    "react-test-renderer": "19.2.0",
    "ts-jest": "^29.2.5",
    "typescript": "5.8.3"
  },
  "kepler": {
    "projectType": "application",
    "appName": "Selene",
    "targets": [
      "tv"
    ]
  },
  "overrides": {
    "react": "19.2.0",
    "react-native": "0.83.0"
  }
}
